PRAGMA foreign_keys = OFF;
BEGIN;

CREATE TABLE coupons_replacement (
  id                    INTEGER PRIMARY KEY AUTOINCREMENT,
  farmer_id             INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  code                  TEXT NOT NULL UNIQUE,
  discount_type         TEXT NOT NULL CHECK(discount_type IN ('percent', 'fixed')),
  discount_value        REAL NOT NULL CHECK(discount_value > 0),
  max_uses              INTEGER,
  used_count            INTEGER NOT NULL DEFAULT 0,
  expires_at            DATETIME,
  created_at            DATETIME DEFAULT CURRENT_TIMESTAMP,
  max_uses_per_user     INTEGER
);

INSERT INTO coupons_replacement
  (id, farmer_id, code, discount_type, discount_value, max_uses, used_count, expires_at, created_at, max_uses_per_user)
SELECT id, farmer_id, code, discount_type, discount_value, max_uses, used_count, expires_at, created_at, max_uses_per_user
FROM coupons;

DROP TABLE coupons;
ALTER TABLE coupons_replacement RENAME TO coupons;

COMMIT;
PRAGMA foreign_keys = ON;
